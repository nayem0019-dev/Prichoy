# Database
DATABASE_URL="mysql://root:password@localhost:3306/prichoy_erp"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-in-production-min-32-chars"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="your-super-secret-refresh-key-change-in-production-min-32-chars"
JWT_REFRESH_EXPIRES_IN="7d"

# Server
PORT=4000
NODE_ENV=development
FRONTEND_URL="http://localhost:3000"
ADMIN_URL="http://localhost:3001"

# Cookie domain for the httpOnly refresh-token cookie.
# Leave BLANK for local development.
# In production, set to your shared parent domain so the cookie set by
# api.yourdomain.com is sent back on requests from admin.yourdomain.com,
# e.g: COOKIE_DOMAIN=.yourdomain.com
COOKIE_DOMAIN=

# Account lockout policy
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=15

# Email — Phase 2: used for order-status customer emails (Order Placed,
# Confirmed, Dispatched, Delivered, Cancelled). If left blank, order
# creation/status changes still succeed — emails just log as FAILED in the
# email_logs table with reason "SMTP is not configured" (see email.service.ts).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@email.com
SMTP_PASS=your-app-password
EMAIL_FROM="Prichoy Clothing <noreply@prichoy.com>"

# File Upload
UPLOAD_PATH="./uploads"
MAX_FILE_SIZE=5242880
# Phase 3 — used to build absolute URLs for uploaded/compressed images.
# Set this to the real public URL of the backend once deployed (e.g.
# https://api.prichoy.com); defaults to localhost for development.
BACKEND_URL="http://localhost:4000"

# Company
COMPANY_NAME="Prichoy Clothing"
COMPANY_PHONE="01762647661"
COMPANY_EMAIL="nayem@mail.com"
COMPANY_ADDRESS="Dhaka, Bangladesh"
